# ==========================================
# VICKY OS — Configuration Environment
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8090
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Database Connection
# In Docker: postgresql://vicky:vickypass@postgres:5432/vicky_os
# Local SQLite for testing: sqlite:///./vicky_os.db
DATABASE_URL=postgresql://vicky:vickypass@postgres:5432/vicky_os
DB_ECHO=false

# Ollama / Local LLM Integration
OLLAMA_BASE_URL=http://192.168.1.20:11434
OLLAMA_TIMEOUT_SECONDS=60.0

# Agent Model Allocations
DEFAULT_MODEL=gemma3:4b
TECHY_MODEL=gemma3:4b
ELDER_MODEL=gemma3:4b
ARCHY_MODEL=gemma3:4b
PA_MODEL=gemma3:4b

# Techy Server Execution Runtime
TECHY_EXEC_PROVIDER=ssh
TECHY_SSH_HOST=192.168.1.123
TECHY_SSH_PORT=22
TECHY_SSH_USER=vickyops
TECHY_SSH_PASSWORD=vickythegoat
TECHY_SSH_KEY_PATH=
TECHY_SUDO_PASSWORD=vickythegoat
TECHY_MAX_STEPS=15
TECHY_LOOP_TIMEOUT_SECONDS=180.0
TECHY_EXEC_TIMEOUT_SECONDS=60.0
